# Windows example: C:\Qudrat\xarid_uz\UZBI
# Linux server: set this to the mounted UZBI data directory, e.g. /srv/uzbi
UZBI_ROOT=C:\Qudrat\xarid_uz\UZBI

# Keep the web login/session database outside the Git checkout in production.
# UZBI_APP_DB=/var/lib/bidata/uzbi_web_app.sqlite3
UZBI_SESSION_HOURS=24
UZBI_COOKIE_SECURE=0

# Required only when creating the first admin account in a new app database.
# Provide a unique password through the private environment file; never commit it.
UZBI_ADMIN_PASSWORD=
