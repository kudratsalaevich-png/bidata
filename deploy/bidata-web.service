[Unit]
Description=BIData Web Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bidata-web
EnvironmentFile=/etc/bidata/bidata.env
ExecStart=/opt/bidata-web/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8090 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
